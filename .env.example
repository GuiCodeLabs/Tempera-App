# Configurações principais do Django
# Gere uma chave nova para produção: https://djecrety.ir/
DJANGO_SECRET_KEY=sua_chave_secreta_aqui

# Mude para False em produção
DEBUG=True

# Lista separada por vírgulas dos domínios permitidos
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth (Obtenha no Google Cloud Console)
GOOGLE_CLIENT_ID=seu_id_de_cliente_aqui.apps.googleusercontent.com